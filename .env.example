# ⚠️ SECURITY WARNING ⚠️
# NEVER commit .env.local with real credentials!
# Copy this file to .env.local and fill with YOUR credentials
# .env.local is already in .gitignore - do NOT remove it

# ========== SUPABASE CONFIGURATION ==========
# Get from: https://app.supabase.com/project/[PROJECT_ID]/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (starts with eyJ)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9... (starts with eyJ, KEEP SECRET)

# ========== OPENAI CONFIGURATION ==========
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-... (starts with sk-proj)

# ========== WHATSAPP CONFIGURATION ==========
# Get from: https://developers.facebook.com/apps/
WHATSAPP_BUSINESS_ACCOUNT_ID=123456789
WHATSAPP_PHONE_NUMBER_ID=987654321
WHATSAPP_ACCESS_TOKEN=EAA... (User access token)
WHATSAPP_WEBHOOK_VERIFY_TOKEN=any-random-string-you-create

# ========== GODADDY MYSQL CONFIGURATION ==========
# Only needed if using GoDaddy as backup storage
GODADDY_MYSQL_HOST=your-godaddy-host.com
GODADDY_MYSQL_USER=your_username
GODADDY_MYSQL_PASSWORD=your_password
GODADDY_MYSQL_DATABASE=your_database_name
GODADDY_MYSQL_PORT=3306

# ========== APPLICATION CONFIGURATION ==========
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ========== SECURITY CONFIGURATION ==========
# Generate with: openssl rand -base64 32 (min 32 chars)
ENCRYPTION_KEY=generate-a-random-key-here-at-least-32-chars
